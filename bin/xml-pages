#!/usr/bin/env php
<?php

declare(strict_types=1);

use MiGears\XmlPages\Compiler;
use MiGears\XmlPages\Exception\CompileException;

foreach ([
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

const USAGE = <<<TXT
Usage: php xml-pages <command> [arguments]

Commands:
  compile <input> [output-dir] [--check]
        Compiles .page.xml page declarations into .tpl.php templates
        <input>       a .page.xml file or directory (directories are recursive)
        [output-dir]  output directory; defaults to the source file's directory
        --check       validate only, do not write files

Options:
  -h, --help   show this help

TXT;

function usage(int $code): never
{
    fwrite($code === 0 ? STDOUT : STDERR, USAGE);
    exit($code);
}

$rest = [];
$check = false;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--help' || $arg === '-h') {
        usage(0);
    }
    if ($arg === '--check') {
        $check = true;
        continue;
    }
    if (str_starts_with($arg, '-')) {
        // An unrecognised option used to fall through to the positional list,
        // where a mistyped --check became the *output directory* — the dry run
        // turned into a real write into a directory named "--chck".
        fwrite(STDERR, "unknown option: {$arg}\n");
        usage(1);
    }
    $rest[] = $arg;
}

if (($rest[0] ?? null) !== 'compile') {
    usage(1);
}

$input = $rest[1] ?? null;
$outputDir = $rest[2] ?? null;
if ($input === null || count($rest) > 3) {
    usage(1);
}

// Both of the checks below describe the installation, not the page, so they run
// before any file is read: the message then appears once, not once per file in a
// directory. Without them each condition left an uncaught Error, a stack trace,
// and exit code 255 — a code no build script can tell apart from its own crash,
// and one that contradicts the exit-code contract this tool documents.
//
// --help is answered above and needs neither the autoloader nor the extensions.
if (! class_exists(Compiler::class)) {
    fwrite(STDERR, "cannot find the composer autoloader; run \"composer install\" in the package, or call the installed vendor/bin/xml-pages instead\n");
    exit(1);
}
// Parsing needs simplexml, and every wrapper element is inspected through DOM.
// Both ship with PHP but both can be compiled out, and composer's "ext-*" lines
// are only checked at install time — not on the machine that later runs this.
foreach (['simplexml_load_string' => 'simplexml', 'dom_import_simplexml' => 'dom'] as $function => $extension) {
    if (! function_exists($function)) {
        fwrite(STDERR, "the {$extension} extension is not loaded; compiling a page declaration needs ext-{$extension}\n");
        exit(1);
    }
}

$compiler = new Compiler(function (string $message): void {
    fwrite(STDERR, "warning: {$message}\n");
});

$compileOne = function (string $file) use ($compiler, $check, $outputDir): void {
    if ($check) {
        $compiler->compileFile($file);
        echo "valid: {$file}\n";

        return;
    }
    $target = $compiler->compileToFile($file, $outputDir);
    echo "compiled {$file} -> {$target}\n";
};

$run = static function () use ($compileOne, $input): int {
    if (is_dir($input)) {
        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($input, FilesystemIterator::SKIP_DOTS)
        );
        $files = [];
        foreach ($iterator as $fileInfo) {
            if ($fileInfo->isFile() && str_ends_with($fileInfo->getFilename(), '.page.xml')) {
                $files[] = $fileInfo->getPathname();
            }
        }
        sort($files);

        $failed = false;
        foreach ($files as $file) {
            try {
                $compileOne($file);
            } catch (CompileException $e) {
                // A page the author has to fix: reported, and the run goes on.
                $failed = true;
                fwrite(STDERR, $file . ': ' . $e->getMessage() . "\n");
            }
        }

        return $failed ? 1 : 0;
    }

    if (! is_file($input)) {
        fwrite(STDERR, "file not found: {$input}\n");

        return 1;
    }

    try {
        $compileOne($input);
    } catch (CompileException $e) {
        fwrite(STDERR, $input . ': ' . $e->getMessage() . "\n");

        return 1;
    }

    return 0;
};

try {
    exit($run());
} catch (Throwable $e) {
    // Last resort. A CompileException names the page's own fault and is handled
    // above; anything reaching this line is the tool breaking instead, and it
    // still owes the caller a message and the documented failure code rather
    // than a fatal error page.
    fwrite(STDERR, 'fatal: ' . $e->getMessage() . "\n");
    exit(1);
}
