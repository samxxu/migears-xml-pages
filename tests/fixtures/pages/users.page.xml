<page title="User management" layout="layout/main">
    <sections>
        <section name="title">
            <text>User management</text>
        </section>
        <section name="content">
            <heading level="2">User list</heading>
            <table items="users" as="user" empty="No data">
                <columns>
                    <column label="ID" pop="{{ user.id }}"/>
                    <column label="Name" pop="{{ user.name }}"/>
                    <column label="Actions">
                        <content>
                            <link href="/users/{{ user.id }}/edit">Edit</link>
                        </content>
                    </column>
                </columns>
            </table>
        </section>
    </sections>
</page>
